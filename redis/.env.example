# Copie para .env e ajuste: cp .env.example .env
# O arquivo .env é ignorado pelo Git. Não versione senhas reais.

# Tag da imagem oficial do Redis
REDIS_IMAGE_TAG=8.8-alpine

# Tag da imagem do painel RedisInsight
REDISINSIGHT_IMAGE_TAG=3.8.0

# Endereço de bind no host (127.0.0.1 = apenas acesso local)
BIND_ADDRESS=127.0.0.1

# Porta publicada no host
REDIS_PORT=6379

# Porta do painel RedisInsight no host
REDISINSIGHT_PORT=5540

# Senha do usuário "default" (obrigatória)
REDIS_PASSWORD=troque-esta-senha

# Limite de memória e política de remoção de chaves
# noeviction  -> recusa escritas quando o limite é atingido (bom para dados)
# allkeys-lru -> remove as chaves menos usadas (bom para cache)
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=noeviction
