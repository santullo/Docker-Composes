# Copie para .env e ajuste: cp .env.example .env
# O arquivo .env é ignorado pelo Git. Não versione senhas reais.

# Tag da imagem oficial (variante "-management" inclui o painel web)
RABBITMQ_IMAGE_TAG=4.3-management

# Endereço de bind no host (127.0.0.1 = apenas acesso local)
BIND_ADDRESS=127.0.0.1

# Portas publicadas no host
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Usuário administrador criado na primeira inicialização (volume vazio).
# Alterar estes valores depois NÃO muda o usuário já existente no volume.
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=troque-esta-senha
RABBITMQ_DEFAULT_VHOST=/
