# Copie para .env e ajuste: cp .env.example .env
# O arquivo .env é ignorado pelo Git. Não versione senhas reais.

# SonarQube Community Build (gratuito). Versões: https://hub.docker.com/_/sonarqube
SONARQUBE_IMAGE_TAG=26.10.0.133078-community

# Endereço de bind no host (127.0.0.1 = apenas acesso local)
BIND_ADDRESS=127.0.0.1

# Porta da interface web
SONARQUBE_PORT=9000

# PostgreSQL dedicado ao SonarQube (sem porta publicada no host)
SONAR_DB_IMAGE_TAG=17-alpine
SONAR_DB_NAME=sonar
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=troque-esta-senha
