# Copie para .env e ajuste: cp .env.example .env
# O arquivo .env é ignorado pelo Git. Este ambiente não usa senhas (PLAINTEXT, apenas local).

# Tags das imagens
KAFKA_IMAGE_TAG=8.3.2
KAFKA_UI_IMAGE_TAG=v1.5.0

# Endereço de bind no host (127.0.0.1 = apenas acesso local)
BIND_ADDRESS=127.0.0.1

# Porta do Kafka no host (também usada no listener anunciado para o host)
KAFKA_PORT=9092

# Porta da interface web Kafka UI
KAFKA_UI_PORT=19000
