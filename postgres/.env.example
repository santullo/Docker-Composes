# Copie para .env e ajuste: cp .env.example .env
# O arquivo .env é ignorado pelo Git. Não versione senhas reais.

# Tag da imagem oficial (mantenha a mesma versão principal dos dados existentes)
POSTGRES_IMAGE_TAG=18

# Endereço de bind no host (127.0.0.1 = apenas acesso local)
BIND_ADDRESS=127.0.0.1

# Porta publicada no host
POSTGRES_PORT=5432

# Credenciais aplicadas apenas na primeira inicialização (diretório de dados vazio)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=postgres

# Origem dos dados:
#   data                  -> volume nomeado "postgres_data" (padrão, recomendado)
#   C:/Meu_Banco_Postgres -> pasta usada pela configuração anterior (Windows)
#   ./dados               -> pasta relativa ao diretório postgres/
POSTGRES_DATA_SOURCE=data
